
.hud-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.joystick-zone {
    position: absolute;
    left: 0; top: 40%; bottom: 0;
    width: 35%;
}

.joystick-base {
    position: absolute;
    width: 260px; height: 260px;
    background-image: url("../Sprites/HUD/hud_joystick_base.png");
    -unity-background-scale-mode: scale-to-fit;
    visibility: hidden;
}

.joystick-knob {
    position: absolute;
    width: 120px; height: 120px;
    background-image: url("../Sprites/HUD/hud_joystick_knob.png");
    -unity-background-scale-mode: scale-to-fit;
    visibility: hidden;
}

/*Boton de pausa: se saca todo el estilo por defecto del Button y se deja solo la imagen */
.hud-button {
    position: absolute;
    top: 40px; right: 60px;
    width: 150px; height: 150px;
    margin: 0; padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Sprites/HUD/hud_boton_pausa.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.12s;
}

.hud-button:hover  { background-color: rgba(0, 0, 0, 0); }
.hud-button:active { background-color: rgba(0, 0, 0, 0); scale: 0.9 0.9; }  /* se hunde al tocarlo */

/* Reloj de ronda: despertador digital. Todo el cuerpo es una imagen de 1040x460 (2x) mostrada a 520x230. */
.reloj {
    position: absolute;
    left: 700px; top: 6px;
    width: 520px; height: 230px;
    background-image: url("../Sprites/HUD/Reloj/reloj_cuerpo.png");
    -unity-background-scale-mode: stretch-to-fill;
    display: none;
}

.reloj-alerta {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("../Sprites/HUD/Reloj/reloj_alerta.png");
    -unity-background-scale-mode: stretch-to-fill;
    display: none;
}

.reloj-digito {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}
.d0 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_0.png"); }
.d1 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_1.png"); }
.d2 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_2.png"); }
.d3 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_3.png"); }
.d4 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_4.png"); }
.d5 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_5.png"); }
.d6 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_6.png"); }
.d7 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_7.png"); }
.d8 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_8.png"); }
.d9 { background-image: url("../Sprites/HUD/Reloj/reloj_digito_9.png"); }

/* Cartel colgante de la fase: imagen de 1200x506 (2x) mostrada a 520x219, arriba a la izquierda.
   CartelFaseUI.cs lo baja, lo balancea y lo sube; el giro es desde el borde de arriba (los cables). */
.cartel {
    position: absolute;
    left: 40px; top: 0;
    width: 520px; height: 219px;
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: 50% 0;
    visibility: hidden;
}
.cartel-tareas    { background-image: url("../Sprites/HUD/Carteles/cartel_tareas.png"); }
.cartel-debate    { background-image: url("../Sprites/HUD/Carteles/cartel_debate.png"); }
.cartel-fin-ronda { background-image: url("../Sprites/HUD/Carteles/cartel_fin_ronda.png"); }
