
.hud-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.joystick-zone {
    position: absolute;
    left: 0; bottom: 0;
    width: 50%; height: 75%;
}

.joystick-base {
    position: absolute;
    width: 260px; height: 260px;
    background-image: url("../Sprites/HUD/hud_joystick_base.png");
    -unity-background-scale-mode: scale-to-fit;
    visibility: hidden;
}

.joystick-knob {
    position: absolute;
    width: 120px; height: 120px;
    background-image: url("../Sprites/HUD/hud_joystick_knob.png");
    -unity-background-scale-mode: scale-to-fit;
    visibility: hidden;
}

/*Boton de pausa: se saca todo el estilo por defecto del Button y se deja solo la imagen */
.hud-button {
    position: absolute;
    top: 40px; right: 60px;
    width: 150px; height: 150px;
    margin: 0; padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Sprites/HUD/hud_boton_pausa.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.12s;
}

.hud-button:hover  { background-color: rgba(0, 0, 0, 0); }
.hud-button:active { background-color: rgba(0, 0, 0, 0); scale: 0.9 0.9; }  /* se hunde al tocarlo */
