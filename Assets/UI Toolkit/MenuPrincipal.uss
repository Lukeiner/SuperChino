/* Menu principal de Super Chino.
   Todo lo que esta dentro de .escenario usa pixeles del fondo original (2576 x 1438).
   El script MenuAnimaciones achica el escenario para que llene la pantalla. */

.menu-container { flex-grow: 1; overflow: hidden; background-color: rgb(27, 15, 22); }

.escenario {
    position: absolute; left: 0; top: 0;
    width: 2576px; height: 1438px;
    transform-origin: 0 0;           /* el script MenuAnimaciones calcula escala y posicion (y hace el zoom a la radio) */
    scale: 0.751 0.751;
}

/* Capa de color que tapa todo al final del zoom (mismo verde oscuro que la pantalla de la radio) */
.fundido { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(15, 31, 27); opacity: 0; }

.capa-completa { position: absolute; left: 0; top: 0; width: 2576px; height: 1438px; }
.cielo  { background-image: url("../Sprites/Menu/fondo_menu.png"); }

.pieza { position: absolute; }

/* Linternas y cartel: transform-origin = el punto de donde cuelgan (el script las hace girar) */
.linterna-izq { left: 260px;  top: 528px; width: 194px; height: 300px; background-image: url("../Sprites/Menu/linterna_izq.png"); transform-origin: 44.3% 0%; }
.linterna-der { left: 2058px; top: 528px; width: 187px; height: 300px; background-image: url("../Sprites/Menu/linterna_der.png"); transform-origin: 51.9% 0%; }
.cartel       { left: 1121px; top: 640px; width: 269px; height: 301px; background-image: url("../Sprites/Menu/cartel_puerta.png"); transform-origin: 50% 6%; }

.gato  { left: 635px;  top: 683px;  width: 232px; height: 320px; background-image: url("../Sprites/Menu/gato_de_la_fortuna.png"); transform-origin: 50% 100%; }
.tv    { left: 1553px; top: 688px;  width: 403px; height: 312px; background-image: url("../Sprites/Menu/tv.png"); }
.radio { left: 534px;  top: 1045px; width: 432px; height: 300px; background-image: url("../Sprites/Menu/radio.png"); }

/* Brillo de las pantallas (el script le cambia la opacidad para el parpadeo) */
.tv-luz    { position: absolute; left: 1585px; top: 717px;  width: 338px; height: 209px; border-radius: 6px; background-color: rgba(191, 255, 226, 0.16); }
.radio-luz { position: absolute; left: 587px;  top: 1139px; width: 326px; height: 86px;  border-radius: 8px; background-color: rgba(143, 240, 200, 0.16); }

/* ---------- TEXTOS ---------- */
.txt {
    position: absolute;
    -unity-text-align: middle-center;
    -unity-font-definition: url("../Fonts/ZCOOLQingKeHuangYou-Regular SDF.asset");
    -unity-font-style: normal;
    margin: 0; padding: 0;
    white-space: nowrap;
}
.txt-titulo   { left: 934px; top: 212px; width: 640px; height: 140px; font-size: 100px; color: rgb(255, 214, 107); letter-spacing: 4px;
                -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(61, 21, 24); text-shadow: 5px 5px 0 rgb(61, 21, 24); }
.txt-tv       { left: 1585px; top: 735px; width: 338px; height: 130px; font-size: 58px; color: rgb(255, 214, 107); white-space: normal; }
.txt-creditos { left: 1585px; top: 862px; width: 338px; height: 56px;  font-size: 44px; color: rgb(207, 255, 233); }
.txt-cartel   { left: 15px;   top: 150px; width: 239px; height: 140px; font-size: 78px; color: rgb(139, 13, 22); }   /* dentro del cartel, se mueve con el */
.txt-radio    { left: 587px;  top: 1139px; width: 326px; height: 86px; font-size: 64px; color: rgb(143, 240, 200); letter-spacing: 4px; }

/* ---------- BOTONES INVISIBLES (zonas tactiles) ---------- */
.zona {
    position: absolute; margin: 0; padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0; border-radius: 16px;
    transition-duration: 0.15s;
}
.zona:hover  { background-color: rgba(255, 240, 200, 0.12); }
.zona:active { background-color: rgba(255, 240, 200, 0.25); }
.zona-jugar    { left: 1057px; top: 606px;  width: 397px; height: 653px; }
.zona-opciones { left: 558px;  top: 1115px; width: 384px; height: 206px; border-radius: 29px; }   /* solo el cuerpo de la radio */
.zona-creditos { left: 1516px; top: 640px;  width: 476px; height: 400px; }
.zona-salir    { left: 2155px; top: 920px;  width: 407px; height: 392px; }

/* =====================================================================
   PANTALLAS DE OPCIONES Y CREDITOS
   ===================================================================== */
.pantalla-completa { flex-grow: 1; overflow: hidden; background-color: rgb(15, 31, 27); }

/* ---------- OPCIONES: la radio de cerca (pixeles de radio_opciones.png, 2576 x 1438) ---------- */
.radio-escenario {
    position: absolute; left: 0; top: 0;
    width: 2576px; height: 1438px;
    transform-origin: 0 0;           /* el script la escala para cubrir la pantalla */
    background-image: url("../Sprites/Menu/radio_opciones.png");
}
/* brillo que "respira" adentro de la pantalla */
.radio-brillo { position: absolute; left: 275px; top: 240px; width: 2025px; height: 828px; border-radius: 40px; background-color: rgba(143, 240, 200, 0.06); }

.lcd-titulo, .lcd-etiqueta, .lcd-porcentaje {
    position: absolute; margin: 0; padding: 0;
    -unity-font-definition: url("../Fonts/ZCOOLQingKeHuangYou-Regular SDF.asset");
    color: rgb(143, 240, 200);
    text-shadow: 0 0 18px rgba(143, 240, 200, 0.8);
}
.lcd-titulo     { left: 275px; top: 280px; width: 2025px; height: 180px; font-size: 160px; letter-spacing: 16px; -unity-text-align: middle-center; color: rgb(207, 255, 233); }
.lcd-etiqueta   { left: 420px; top: 520px; width: 900px;  height: 100px; font-size: 92px;  letter-spacing: 6px; -unity-text-align: middle-left; }
.lcd-porcentaje { left: 1990px; top: 640px; width: 230px; height: 110px; font-size: 96px; -unity-text-align: middle-right; }

/* La barra de volumen. El Slider de Unity tiene partes internas con nombres fijos (unity-base-slider__...) */
.lcd-slider { position: absolute; left: 420px; top: 640px; width: 1530px; height: 110px; margin: 0; padding: 0; }
.lcd-slider .unity-base-slider__input { height: 110px; }
.lcd-slider .unity-base-slider__drag-container { height: 110px; }
.lcd-slider .unity-base-slider__tracker {
    height: 40px; top: 35px; margin-top: 0;
    background-color: rgb(10, 24, 20);
    border-width: 5px; border-color: rgb(58, 90, 82); border-radius: 20px;
    overflow: hidden;
}
.lcd-relleno { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: rgb(143, 240, 200); }  /* lo ajusta el script */
.lcd-slider .unity-base-slider__dragger {
    width: 90px; height: 90px; top: 10px; margin-top: 0; margin-left: -45px;
    border-radius: 45px; border-width: 10px; border-color: rgb(15, 31, 27);
    background-color: rgb(207, 255, 233);
}
.lcd-slider .unity-base-slider__dragger-border { display: none; }

.lcd-boton {
    position: absolute; left: 998px; top: 860px; width: 580px; height: 150px; margin: 0; padding: 0;
    -unity-font-definition: url("../Fonts/ZCOOLQingKeHuangYou-Regular SDF.asset");
    font-size: 104px; letter-spacing: 8px; -unity-text-align: middle-center;
    color: rgb(143, 240, 200); background-color: rgba(143, 240, 200, 0.06);
    border-width: 8px; border-color: rgb(143, 240, 200); border-radius: 30px;
    transition-duration: 0.15s;
}
.lcd-boton:hover  { background-color: rgb(143, 240, 200); color: rgb(15, 31, 27); }
.lcd-boton:active { scale: 0.96 0.96; }

/* ---------- CREDITOS estilo Star Wars ---------- */
.creditos { background-color: rgb(6, 5, 12); }
.estrellas { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("../Sprites/Menu/estrellas.png"); -unity-background-scale-mode: scale-and-crop; }

.cred-intro, .cred-logo, .cred-linea, .cred-boton {
    -unity-font-definition: url("../Fonts/ZCOOLQingKeHuangYou-Regular SDF.asset");
    -unity-text-align: middle-center; margin: 0; padding: 0;
}
.cred-intro { position: absolute; left: 0; right: 0; top: 0; bottom: 0; font-size: 56px; letter-spacing: 3px; color: rgb(75, 213, 238); opacity: 0; }
.cred-logo  { position: absolute; left: 0; right: 0; top: 0; bottom: 0; font-size: 300px; color: rgb(0, 0, 0); opacity: 0;
              -unity-text-outline-width: 6px; -unity-text-outline-color: rgb(255, 214, 107); }   /* letras huecas como el logo de Star Wars */

/* el texto que sube: el script mueve y achica cada linea para fingir la perspectiva */
.cred-texto { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.cred-linea { position: absolute; left: 0; width: 100%; height: 80px; font-size: 64px; letter-spacing: 4px; color: rgb(255, 214, 107); white-space: nowrap; }
.cred-episodio  { font-size: 64px; }
.cred-subtitulo { font-size: 92px; height: 120px; }
.cred-rol       { font-size: 52px; color: rgb(255, 233, 168); }
.cred-nombre    { font-size: 84px; height: 110px; }
.cred-espacio   { height: 120px; }
.cred-gracias   { font-size: 96px; height: 130px; }

.cred-boton {
    position: absolute; left: 40px; top: 40px; width: 300px; height: 96px;
    font-size: 64px; letter-spacing: 4px;
    color: rgb(255, 214, 107); background-color: rgba(0, 0, 0, 0.4);
    border-width: 5px; border-color: rgb(255, 214, 107); border-radius: 24px;
    transition-duration: 0.15s;
}
.cred-boton:hover { background-color: rgb(255, 214, 107); color: rgb(6, 5, 12); }
