:root {
}

.buttonstyle {
    position: relative;
    align-self: center;
    height: 144px;
    width: 665px;
    margin-bottom: 24px;
    padding: 0;
    font-size: 80px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgb(71, 132, 132);
    border-radius: 50px;
    transition-duration: 0.2s;
}



.buttonstyle:hover {
    scale: 1.1 1.1;
    background-color: rgb(52, 91, 91);
}



.buttonstyle:active {
    background-color: rgb(52, 91, 91);
}