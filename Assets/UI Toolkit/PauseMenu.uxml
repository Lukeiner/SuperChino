<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="MenuPausa.uss" />
    <!-- Tabla = el portapapeles entero. El script PausaAnimaciones lo mueve, lo achica y lo da vuelta. -->
    <ui:VisualElement name="Tabla" class="tabla" picking-mode="Ignore">

        <!-- FRENTE: la hoja con la lista -->
        <ui:VisualElement name="PauseContainer" class="cara cara-frente" style="display: none;">
            <ui:Label text="PAUSA" class="lapiz titulo-pausa" picking-mode="Ignore" />
            <ui:VisualElement class="raya-titulo" picking-mode="Ignore" />
            <ui:Button name="resumeButton" text="REANUDAR" class="lapiz lapiz-boton b-reanudar">
                <ui:VisualElement class="subrayado" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="optionsButton" text="OPCIONES" class="lapiz lapiz-boton b-opciones">
                <ui:VisualElement class="subrayado" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="quitButton" text="SALIR" class="lapiz lapiz-boton b-salir">
                <ui:VisualElement class="subrayado" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <!-- ATRAS: el papel arrancado y pegado con cinta -->
        <ui:VisualElement name="PauseOptionsContainer" class="cara cara-atras" style="display: none;">
            <!-- Todo lo que va adentro de PapelAtras gira igual que el papel dibujado -->
            <ui:VisualElement name="PapelAtras" class="papel-atras" picking-mode="Ignore">
                <ui:Label text="OPCIONES" class="lapiz titulo-opciones" picking-mode="Ignore" />
                <ui:Label text="VOLUMEN" class="lapiz etiqueta-volumen" picking-mode="Ignore" />
                <ui:Label name="VolumenPorcentaje" text="100%" class="lapiz porcentaje" picking-mode="Ignore" />
                <ui:Button name="backButton" text="VOLVER" class="lapiz lapiz-boton b-volver">
                    <ui:VisualElement class="subrayado" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <!-- El slider queda afuera de PapelAtras para que NO gire -->
            <ui:Slider name="volumeSlider" low-value="0" high-value="1" value="1" class="lapiz-slider" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
